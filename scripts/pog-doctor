#!/usr/bin/env bash
# pog-doctor [--ci] [<repo>] - deterministic conventions lint for a
# pack-managed repo.
#
# Checks (each a hard failure unless marked WARN):
#   1. .gitignore carries .context/, .artifacts/, .worktrees/
#   2. no files from those directories are tracked (the tracked-before-ignored
#      trap: gitignore only hides *new* files, it never untracks old ones)
#   3. the reference-transaction main-protection hook is installed, executable,
#      and not a dangling symlink — skipped under --ci, CI/GITHUB_ACTIONS, or
#      a Kitsoki capsule clone (identified by its workspace path plus source
#      remote), because
#      hooks live in .git/ and never survive a clone; the hook guards primary
#      working clones, while capsule CI guards the tracked files
#   4. AGENTS.md exists and carries the pack conventions marker block
#   5. scripts/promote-to-main.sh and scripts/merge-to-main.sh exist and are executable
#   W. the repo has a remote but no scripts/sync-main-from-remote.sh
#
# Exit 0 when every hard check passes. Designed for CI: no network, no LLM,
# output is one line per check.
set -euo pipefail

ci_mode=0
hook_skip_reason="CI checkout — hooks don't survive a clone"
repo="."
while [ "$#" -gt 0 ]; do
  case "$1" in
    --ci) ci_mode=1; shift ;;
    -*) echo "pog-doctor: unknown flag: $1" >&2; exit 2 ;;
    *) repo="$1"; shift ;;
  esac
done
if [ "${CI:-}" = "true" ] || [ "${GITHUB_ACTIONS:-}" = "true" ]; then
  ci_mode=1
fi
cd "$repo"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "pog-doctor: not a git repository: $repo" >&2
  exit 2
fi

# Managed Capsules are freshly cloned from their protected checkout and do not
# inherit hooks. The workspace path is the stable identity: different Capsule
# providers name the local clone remote differently (`source` or `origin`).
case "$(pwd -P)" in
  */.capsules/workspaces/*) capsule_workspace=1 ;;
  *) capsule_workspace=0 ;;
esac
if [ "$ci_mode" -eq 0 ] && [ "$capsule_workspace" -eq 1 ]; then
  ci_mode=1
  hook_skip_reason="Kitsoki capsule clone — hooks don't survive a clone"
elif [ "$ci_mode" -eq 1 ]; then
  hook_skip_reason="CI checkout — hooks don't survive a clone"
fi

fail=0
ok()   { echo "  ok    $*"; }
bad()  { echo "  FAIL  $*"; fail=1; }
warn() { echo "  warn  $*"; }

echo "pog-doctor: $(git rev-parse --show-toplevel)"

# 1. gitignore entries
for entry in .context .artifacts .worktrees; do
  if [ -f .gitignore ] && grep -qE "^${entry}/?$" .gitignore; then
    ok ".gitignore covers ${entry}/"
  else
    bad ".gitignore is missing ${entry}/"
  fi
done

# 2. nothing tracked under the private dirs
tracked="$(git ls-files -- .context .artifacts .worktrees)"
if [ -z "$tracked" ]; then
  ok "no tracked files under .context/ .artifacts/ .worktrees/"
else
  bad "tracked files under private dirs (git rm --cached them):"
  printf '%s\n' "$tracked" | sed 's/^/          /'
fi

# 3. main-protection hook installed and healthy (meaningless in a CI clone)
if [ "$ci_mode" -eq 1 ]; then
  ok "hook check skipped ($hook_skip_reason)"
else
  hook="$(git rev-parse --git-path hooks)/reference-transaction"
  if [ -L "$hook" ] && [ ! -e "$hook" ]; then
    bad "reference-transaction hook is a dangling symlink: $hook"
  elif [ ! -e "$hook" ]; then
    bad "reference-transaction hook not installed: $hook"
  elif [ ! -x "$hook" ]; then
    bad "reference-transaction hook is not executable: $hook"
  else
    ok "reference-transaction main-protection hook installed"
  fi
fi

# 4. AGENTS.md conventions block
if [ -f AGENTS.md ] && grep -q "pack:conventions:begin" AGENTS.md; then
  ok "AGENTS.md carries the pack conventions block"
else
  bad "AGENTS.md missing or lacks the pack:conventions marker block"
fi

# 5. landing scripts present
if [ -x scripts/promote-to-main.sh ]; then
  ok "scripts/promote-to-main.sh present and executable"
else
  bad "scripts/promote-to-main.sh missing or not executable"
fi
if [ -x scripts/merge-to-main.sh ]; then
  ok "scripts/merge-to-main.sh present and executable"
else
  bad "scripts/merge-to-main.sh missing or not executable"
fi

# W. remote repos should carry the reconciliation script
if git remote | grep -q . && [ ! -x scripts/sync-main-from-remote.sh ]; then
  warn "repo has a remote but no scripts/sync-main-from-remote.sh"
fi

if [ "$fail" -ne 0 ]; then
  echo "pog-doctor: FAIL"
  exit 1
fi
echo "pog-doctor: ok"
