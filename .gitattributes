# --- repo-specific overrides (must stay AFTER the mergiraf block) ----------
#
# Verify any override with the ambient config neutralised, or a machine-global
# ~/.config/git/attributes will make a naive check pass regardless of what this
# file says:
#
#     GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
#       git check-attr merge -- <path>

# Dependency lockfiles are NOT source. The generated block above marks *.json
# and *.yaml `merge=mergiraf`, which would capture them: a syntax-aware merge
# can emit a structurally valid lockfile whose resolved dependency tree and
# `integrity` hashes disagree — silently wrong, with no conflict marker to warn
# anyone. Regenerate instead. None of these are tracked today; they are listed
# so the first one added is safe by default.
package-lock.json   merge=text
npm-shrinkwrap.json merge=text
pnpm-lock.yaml      merge=text
yarn.lock           merge=text
bun.lockb           merge=text
Cargo.lock          merge=text
poetry.lock         merge=text
uv.lock             merge=text
composer.lock       merge=text
Gemfile.lock        merge=text

# Emitted trees. packages/feedback-core/dist/kitsoki-embed/** is re-emitted from
# a pinned source revision (see the `chore(embed): refresh kitsoki-embed
# manifest` commits) and packages/*/vendor/** is copied in wholesale. Merging
# two regenerations line-by-line — or worse, syntax-aware — produces a tree that
# corresponds to no source revision. Take the conflict and re-emit.
packages/feedback-core/dist/kitsoki-embed/** merge=binary
packages/*/vendor/**                         merge=binary

# Recorded evidence and demo/tour goldens are generated artifacts, not source.
# A three-way merge of two regenerated recordings is never meaningful; take the
# conflict and re-record instead of silently interleaving two runs.
pog/evidence/*.json          merge=binary
stories/*/fixtures/**/*.json merge=binary

# Screenshots / posters.
*.png binary
