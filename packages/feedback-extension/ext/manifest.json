{
  "manifest_version": 3,
  "name": "Sassfully Feedback",
  "version": "0.1.0",
  "description": "Zero-integration contextual feedback: rrweb replay and browser telemetry, reviewed before anything leaves your browser.",
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "Sassfully feedback" },
  "options_page": "options/options.html",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "alarms"],
  "optional_host_permissions": ["https://www.linkedin.com/*"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*" },
  "web_accessible_resources": [
    { "resources": ["content/*", "vendor/*", "story-bridge-policy.mjs"], "matches": ["https://www.linkedin.com/*", "http://127.0.0.1/*"] }
  ]
}
