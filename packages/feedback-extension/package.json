{
  "name": "@sassfully/feedback-extension",
  "version": "0.1.0",
  "description": "Zero-integration browser-extension mode: rrweb recording ring, browser telemetry relay, host-SDK enrichment bridge, and a local-first reviewed-bundle store.",
  "type": "module",
  "main": "src/index.mjs",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "story-bridge": "node story-bridge/stdio-server.mjs",
    "demo:sync-desktop": "npm run build && rsync -a --delete dist/ ~/Desktop/sassfully-demo-extension/",
    "demo:serve": "node ../../examples/host-page/serve.mjs",
    "demo:send": "node scripts/demo-send.mjs",
    "test:replay-fixture": "node --test test/replay-fixture.test.mjs"
  }
}
