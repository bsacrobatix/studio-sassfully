{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://kitsoki.dev/schemas/tour-v2.schema.json",
  "title":"Tour v2",
  "description":"App-agnostic click-through tour format. Compatibility mirror of the Kitsoki v2 wire contract.",
  "type":"object","required":["version","id","steps"],"additionalProperties":false,
  "properties":{"version":{"const":2},"id":{"type":"string","minLength":1},"origin":{"type":"string"},"steps":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/step"}}},
  "definitions":{
    "step":{"type":"object","required":["id","kind"],"additionalProperties":false,"properties":{"id":{"type":"string","minLength":1},"route":{"type":"string"},"target":{"$ref":"#/definitions/targetBundle"},"popover":{"$ref":"#/definitions/popover"},"kind":{"type":"string","enum":["highlight","gate","act","navigate"]},"advanceOn":{"$ref":"#/definitions/advanceOn"},"act":{"$ref":"#/definitions/actSpec"},"policy":{"type":"string","enum":["watch","confirm","auto"],"default":"confirm"},"interaction":{"type":"string","enum":["block","allow"]},"viewport":{"type":"string"},"data":{"type":"object"}}},
    "targetBundle":{"type":"object","additionalProperties":false,"properties":{"role":{"type":"string"},"name":{"type":"string"},"testid":{"type":"string"},"text":{"type":"string"},"css":{"type":"string"},"ancestor":{"type":"string"},"frame":{"type":"array","items":{"type":"string"}},"waitFor":{"$ref":"#/definitions/waitFor"}}},
    "waitFor":{"type":"object","additionalProperties":false,"properties":{"timeoutMs":{"type":"integer","minimum":0}}},
    "popover":{"type":"object","additionalProperties":false,"properties":{"title":{"type":"string"},"body":{"type":"string"},"side":{"type":"string","enum":["top","bottom","left","right","center"]},"align":{"type":"string","enum":["start","center","end"]}}},
    "advanceOn":{"type":"object","additionalProperties":false,"properties":{"event":{"type":"string","enum":["click","input","route","submit"]}}},
    "actSpec":{"type":"object","additionalProperties":false,"properties":{"kind":{"type":"string","enum":["click","fill","scroll","press"]},"value":{"type":"string"}}},
    "healEvent":{"type":"object","required":["stepId","failedAnchor","matchedAnchor","confidence"],"additionalProperties":false,"properties":{"stepId":{"type":"string"},"failedAnchor":{"type":"string"},"matchedAnchor":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}}}
  }
}
